generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SYSTEM_ADMIN
  ADMIN
  MANAGER
  GODOWN_KEEPER
  CASHIER
  STAFF
  DELIVERY_BOY
}

enum AgencyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CORRECTION_NEEDED
}

enum PaymentMode {
  CASH
  ONLINE
  CREDIT
}

enum TransactionType {
  NEW_CONNECTION
  REGULATOR
  REGULATOR_REPLACE
  PIPE
  OTHER
  CYLINDER_REFILL
}

enum CustomerType {
  DOMESTIC
  COMMERCIAL
}

enum VehicleAssetType {
  VEHICLE
  AGENCY
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum TripStatus {
  LOADED
  OUT_FOR_DELIVERY
  RETURNED
  PARTIAL_RETURN
}

enum GodownMoveType {
  RECEIVED        // Product arrived at godown from company
  DISPATCHED      // Product sent from godown to office
}

enum SalaryEntryType {
  SALARY          // Regular monthly salary payment
  DRAWING         // Owner drawing
  ADVANCE         // Advance given (udhari)
  ADVANCE_RECOVERY // Advance recovered from salary
  BONUS           // Bonus payment
  DEDUCTION       // Deduction from salary
}

enum AdvanceStatus {
  PENDING         // Advance outstanding
  PARTIAL         // Partially recovered
  RECOVERED       // Fully recovered
}

enum SalaryRequestStatus {
  PENDING         // Awaiting manager approval (employee-initiated)
  MANAGER_APPROVED // Manager approved, awaiting admin approval
  APPROVED        // Approved and processed
  REJECTED        // Rejected by admin or manager
}

enum EmployeeExpenseStatus {
  PENDING           // Awaiting manager review
  MANAGER_APPROVED  // Manager approved, awaiting admin
  APPROVED          // Admin approved — fully processed
  REJECTED          // Rejected (by manager or admin)
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  HALF_DAY
  EMERGENCY
  MATERNITY
  PATERNITY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Agency {
  id              String       @id @default(cuid())
  name            String
  slug            String?      @unique  // subdomain identifier e.g. "sharma" → sharma.localhost:3000
  ownerName       String
  email           String       @unique
  phone           String
  address         String
  city            String
  state           String
  gstin           String?
  distributorCode String?
  oilCompany      String?
  licenseNo       String?
  status          AgencyStatus @default(ACTIVE)
  plan            String       @default("basic")
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // ── Phase 1: Agency upgrades ────────────────────────────────
  logoBase64       String?   @db.Text          // Base64-encoded agency logo
  themeColor       String    @default("#2563eb") // Primary brand color
  subscriptionPlan String    @default("basic") // basic | professional | enterprise
  trialEndsAt      DateTime?                   // Trial expiry date (null = no trial)
  maxUsers         Int       @default(10)       // Max concurrent users allowed
  timezone         String    @default("Asia/Kolkata") // Agency local timezone
  whatsappApiKey   String?                     // Meta WhatsApp Business API key

  users              User[]
  products           Product[]
  customers          Customer[]
  godownRecords      GodownRecord[]
  godownInventory    GodownInventory[]
  stockRecords       StockRecord[]
  dailySummaries     DailySummary[]
  sectionSummaries   SectionSummary[]
  deliveryRecords    DeliveryRecord[]
  commercialSales    CommercialSale[]
  officeTransactions OfficeTransaction[]
  creditEntries      CreditLedgerEntry[]
  salaryDrawings     SalaryDrawing[]
  salaryProfiles     EmployeeSalaryProfile[]
  salaryAdvances     SalaryAdvance[]
  salaryBonuses      SalaryBonus[]
  salaryRequests     SalaryPaymentRequest[]
  leaveRequests      LeaveRequest[]
  expenses           Expense[]
  vehicles           VehicleAgencyAsset[]
  gstInvoices        GstInvoice[]
  dailyClosings      DailyClosing[]
  employeeClosings   DailyClosingEmployee[]
  deliveryVehicles   DeliveryVehicle[]
  vehicleTripLogs    VehicleTripLog[]
  regulatorRecords   RegulatorRecord[]

  // Phase 1 relations
  subscription       AgencySubscription?
  notifications      Notification[]
  messageLogs        MessageLog[]
  deliveryTargets    DeliveryTarget[]
  customerComplaints CustomerComplaint[]
  deliveryRoutes     DeliveryRoute[]

  // Phase 2 relations
  expenseCategories  ExpenseCategory[]
  attendanceRecords  Attendance[]
  paymentReceipts    PaymentReceipt[]
  documents          Document[]
  attendanceRegularizations AttendanceRegularization[]
  workShifts                WorkShift[]

  // Phase 3 relations
  branches           Branch[]
  apiKeys            ApiKey[]
  webhooks           Webhook[]

  // Phase 4 relations
  rolePermissions    RolePermission[]
  leaveBalances      LeaveBalance[]

  // SaaS billing
  cashfreeTransactions CashfreeTransaction[]

  // Feature gating — keys of features enabled for this agency (empty = all features)
  enabledFeatures    String[]          @default([])
  companyPayments    CompanyPayment[]
  customRoles        CustomRole[]

  // Personal Finance & Accounts relations
  personalAccounts        PersonalAccount[]
  personalTransactions    PersonalTransaction[]
  personalUdhaaris        PersonalUdhaari[]
  cheques                 ChequeRegister[]
  oilCompanyLedgers       OilCompanyLedger[]
  dailyCashReconciliations DailyCashReconciliation[]
  fdLoans                 FdLoanRecord[]
  vendorLedgers           VendorLedger[]
  employeeExpenses        EmployeeExpense[]
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String?
  password       String
  role           Role
  customRole     String?  // Name of the custom role (e.g. "Senior Accountant")
  customRoleId   String?  // Reference to CustomRole
  isActive       Boolean  @default(true)
  agencyId       String?
  agency         Agency?  @relation(fields: [agencyId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Extended employee profile fields
  bankAccountNo  String?  // Bank account number
  bankName       String?  // Bank name (e.g., SBI, HDFC)
  ifscCode       String?  // IFSC code
  aadhaarNo      String?  // 12-digit Aadhaar number (AES-256-GCM encrypted)
  panNo          String?  // 10-char PAN card number (AES-256-GCM encrypted)
  photoBase64    String?  @db.Text  // Base64-encoded profile photo (thumbnail)

  // Security & session tracking
  passwordChangedAt   DateTime?  // Invalidates tokens issued before this time
  lastLoginAt         DateTime?  // Last successful login timestamp
  lastLoginIp         String?    // IP address of last login

  // ── Phase 1: User security upgrades ────────────────────────
  failedLoginAttempts  Int       @default(0)   // Resets to 0 on successful login
  lockedUntil          DateTime?               // Account locked until this timestamp
  twoFactorSecret      String?                 // TOTP base32 secret (Phase 3 2FA)
  twoFactorEnabled     Boolean   @default(false) // Whether TOTP 2FA is active
  twoFactorBackupCodes String[]  @default([])  // SHA-256 hashed one-time backup codes

  dailySummaries     DailySummary[]     @relation("SubmittedBy")
  managedSummaries   DailySummary[]     @relation("ApprovedByManager")
  adminSummaries     DailySummary[]     @relation("ApprovedByAdmin")
  godownRecords      GodownRecord[]
  officeTransactions OfficeTransaction[]
  salaryDrawings     SalaryDrawing[]
  salaryProfile      EmployeeSalaryProfile?
  salaryAdvances     SalaryAdvance[]
  salaryBonuses      SalaryBonus[]
  expenses           Expense[]
  deliveries         DeliveryRecord[]
  creditEntries      CreditLedgerEntry[]
  employeeClosings   DailyClosingEmployee[] @relation("EmployeeClosings")
  commercialSales          CommercialSale[]       @relation("CommercialSaleAddedBy")
  commercialSaleDeliveries CommercialSale[]       @relation("CommercialSaleDeliveredBy")
  assignedVehicle    DeliveryVehicle?   @relation("AssignedDeliveryBoy")
  vehicleTripLogs    VehicleTripLog[]
  godownInventory    GodownInventory[]
  refreshTokens      RefreshToken[]

  // Salary approval workflow
  salaryRequestsAsEmployee  SalaryPaymentRequest[] @relation("SalaryRequestEmployee")
  salaryRequestsMade        SalaryPaymentRequest[] @relation("SalaryRequestedBy")
  salaryRequestsReviewed    SalaryPaymentRequest[] @relation("SalaryReviewedBy")
  salaryRequestsManagerReviewed SalaryPaymentRequest[] @relation("SalaryManagerReviewer")

  // Leave management
  leaveRequests             LeaveRequest[]         @relation("EmployeeLeaves")
  reviewedLeaves            LeaveRequest[]         @relation("ReviewedLeaves")

  // Phase 1 relations
  notifications             Notification[]
  deliveryTargets           DeliveryTarget[]
  resolvedComplaints        CustomerComplaint[]    @relation("ComplaintResolver")
  assignedRoutes            DeliveryRoute[]

  // Phase 2 relations
  attendance                Attendance[]
  collectedReceipts         PaymentReceipt[]
  uploadedDocuments         Document[]
  regularizationRequests    AttendanceRegularization[] @relation("RegularizationEmployee")
  reviewedRegularizations   AttendanceRegularization[] @relation("RegularizationReviewer")

  leaveBalances             LeaveBalance[]
  companyPayments           CompanyPayment[]

  // Personal Finance & Accounts relations
  personalAccounts         PersonalAccount[]
  personalTransactions     PersonalTransaction[]
  personalUdhaaris         PersonalUdhaari[]
  udhaariRecoveries        UdhaariRecovery[]
  cheques                  ChequeRegister[]
  oilCompanyLedgers        OilCompanyLedger[]
  dailyCashReconciliations DailyCashReconciliation[]
  fdLoans                  FdLoanRecord[]
  vendorLedgerEntries      VendorLedgerEntry[]
  submittedEmployeeExpenses EmployeeExpense[] @relation("ExpenseSubmittedBy")
  managerEmployeeExpenses   EmployeeExpense[] @relation("ExpenseManager")
  adminEmployeeExpenses     EmployeeExpense[] @relation("ExpenseAdmin")
}

model Product {
  id         String  @id @default(cuid())
  name       String
  unitCost   Float   @default(0)
  saleRate   Float   @default(0)
  margin     Float   @default(0)
  isActive   Boolean @default(true)
  isCylinder Boolean @default(true)
  agencyId   String
  agency     Agency  @relation(fields: [agencyId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // ── Phase 1: GST Quick Win ──────────────────────────────────
  hsnCode    String?  // HSN code for GST (e.g. "2711" for LPG cylinders)
  gstRate    Float    @default(5) // GST % applicable (default 5% for LPG)

  stockRecords       StockRecord[]
  deliveryRecords    DeliveryRecord[]
  commercialSales    CommercialSale[]
  officeTransactions OfficeTransaction[]
  godownInventory    GodownInventory[]
  companyPayments    CompanyPayment[]
}

/// Tracks product movements in the godown — received from company or dispatched to agency office
model GodownInventory {
  id          String          @id @default(cuid())
  date        DateTime
  moveType    GodownMoveType
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  qty         Int
  batchNo     String?
  invoiceNo   String?
  invoiceDate DateTime?
  notes       String?
  recordedById String
  recordedBy  User            @relation(fields: [recordedById], references: [id])
  agencyId    String
  agency      Agency          @relation(fields: [agencyId], references: [id])
  recordLat   Float?
  recordLng   Float?
  recordAccuracy Float?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Customer {
  id            String       @id @default(cuid())
  name          String
  phone         String
  address       String?
  type          CustomerType @default(DOMESTIC)
  customerCode  String?
  email         String?
  gstNumber     String?
  contactPerson String?
  businessType  String?
  isActive      Boolean      @default(true)
  agencyId      String
  agency        Agency       @relation(fields: [agencyId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  deliveries         DeliveryRecord[]
  creditEntries      CreditLedgerEntry[]
  commercialSales    CommercialSale[]
  complaints         CustomerComplaint[]   // Phase 1
  paymentReceipts    PaymentReceipt[]      // Phase 2
  officeTransactions OfficeTransaction[]
  regulators         RegulatorRecord[]
}

model GodownRecord {
  id                      String         @id @default(cuid())
  vehicleNo               String
  entryDate               DateTime
  filledCylindersReceived Int
  emptyCylindersReturned  Int
  items                   Json?          // Array of objects: { productId: string, productName: string, filledReceived: number, emptyReturned: number }
  notes                   String?
  ervNo                   String?
  ervDate                 DateTime?
  status                  ApprovalStatus @default(PENDING)
  submittedById           String
  submittedBy             User           @relation(fields: [submittedById], references: [id])
  agencyId                String
  agency                  Agency         @relation(fields: [agencyId], references: [id])
  approvedAt              DateTime?
  entryLat                Float?
  entryLng                Float?
  entryAccuracy           Float?
  exitLat                 Float?
  exitLng                 Float?
  exitAccuracy            Float?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
}

model StockRecord {
  id           String   @id @default(cuid())
  date         DateTime
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  agencyId     String
  agency       Agency   @relation(fields: [agencyId], references: [id])
  openingStock Int      @default(0)
  loadingIn    Int      @default(0)
  salesQty     Int      @default(0)
  returned     Int      @default(0)
  closingStock Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DailySummary {
  id                  String         @id @default(cuid())
  date                DateTime
  submittedById       String
  submittedBy         User           @relation("SubmittedBy", fields: [submittedById], references: [id])
  summaryData         Json
  status              ApprovalStatus @default(PENDING)
  managerNote         String?
  approvedByManagerId String?
  approvedByManager   User?          @relation("ApprovedByManager", fields: [approvedByManagerId], references: [id])
  managerApprovedAt   DateTime?
  approvedByAdminId   String?
  approvedByAdmin     User?          @relation("ApprovedByAdmin", fields: [approvedByAdminId], references: [id])
  adminApprovedAt     DateTime?
  agencyId            String
  agency              Agency         @relation(fields: [agencyId], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model SectionSummary {
  id              String         @id @default(cuid())
  date            DateTime
  sectionType     String
  data            Json
  status          ApprovalStatus @default(PENDING)
  adminApprovedAt DateTime?
  agencyId        String
  agency          Agency         @relation(fields: [agencyId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model DeliveryRecord {
  id            String   @id @default(cuid())
  date          DateTime
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  deliveredQty  Int      @default(0)
  returnedQty   Int      @default(0)
  pendingQty    Int      @default(0)
  cashCollected Float    @default(0)
  paymentMode   String   @default("CASH")  // CASH | CREDIT | PARTIAL | PhonePe | GPay | Paytm | Others
  creditAmount  Float    @default(0)       // Udhari amount — used for CREDIT and PARTIAL payment modes
  status        String   @default("DELIVERED")
  notes         String?
  deliveredById String
  deliveredBy   User     @relation(fields: [deliveredById], references: [id])
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id])
  deliveryLat   Float?
  deliveryLng   Float?
  deliveryAccuracy Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CommercialSale {
  id            String   @id @default(cuid())
  date          DateTime
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  qty           Int
  rate          Float
  amount        Float
  cashCollected Float    @default(0)
  udhariNew     Float    @default(0)
  udhariPrev    Float    @default(0)
  balance       Float    @default(0)
  addedById     String
  addedBy       User     @relation("CommercialSaleAddedBy", fields: [addedById], references: [id])
  deliveredById String?
  deliveredBy   User?    @relation("CommercialSaleDeliveredBy", fields: [deliveredById], references: [id])
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OfficeTransaction {
  id          String          @id @default(cuid())
  date        DateTime
  type        TransactionType
  inventoryId String?
  product     Product?        @relation(fields: [inventoryId], references: [id])
  customerId  String?
  customer    Customer?       @relation(fields: [customerId], references: [id])
  description String?
  qty         Int             @default(1)
  unitRate    Float           @default(0)
  amount      Float           @default(0)
  paymentMode String          @default("CASH")
  remarks     String?
  addedById   String
  addedBy     User            @relation(fields: [addedById], references: [id])
  agencyId    String
  agency      Agency          @relation(fields: [agencyId], references: [id])
  creditEntry CreditLedgerEntry?
  regulatorIssued RegulatorRecord? @relation("RegulatorIssued")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model CreditLedgerEntry {
  id          String   @id @default(cuid())
  date        DateTime
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  type        String
  amount      Float
  description String?
  addedById   String
  addedBy     User     @relation(fields: [addedById], references: [id])
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  officeTransactionId String?            @unique
  officeTransaction   OfficeTransaction? @relation(fields: [officeTransactionId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RegulatorRecord {
  id                  String             @id @default(cuid())
  regulatorNo         String
  status              String             @default("ISSUED")
  issuedAt            DateTime           @default(now())
  customerId          String
  customer            Customer           @relation(fields: [customerId], references: [id])
  officeTransactionId String?            @unique
  officeTransaction   OfficeTransaction? @relation("RegulatorIssued", fields: [officeTransactionId], references: [id], onDelete: Cascade)
  replacedById        String?            @unique
  replacedBy          RegulatorRecord?   @relation("RegulatorReplacement", fields: [replacedById], references: [id])
  replacesId          String?
  replaces            RegulatorRecord?   @relation("RegulatorReplacement")
  notes               String?
  agencyId            String
  agency              Agency             @relation(fields: [agencyId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([regulatorNo, agencyId])
}

model SalaryDrawing {
  id         String   @id @default(cuid())
  date       DateTime
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id])
  type       String
  amount     Float
  month      Int
  year       Int
  remarks    String?
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Expense {
  id               String           @id @default(cuid())
  date             DateTime
  description      String
  amount           Float
  category         String           // Free-text fallback
  categoryId       String?          // FK to ExpenseCategory (Phase 2)
  expenseCategory  ExpenseCategory? @relation(fields: [categoryId], references: [id])
  addedById        String
  addedBy          User             @relation(fields: [addedById], references: [id])
  agencyId         String
  agency           Agency           @relation(fields: [agencyId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model VehicleAgencyAsset {
  id               String           @id @default(cuid())
  assetType        VehicleAssetType
  name             String
  registrationDate DateTime
  lastRenewalDate  DateTime?
  nextRenewalDate  DateTime?
  price            Float            @default(0)
  comment          String?
  isActive         Boolean          @default(true)
  agencyId         String
  agency           Agency           @relation(fields: [agencyId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  reminders RenewalReminder[]
}

model RenewalReminder {
  id          String             @id @default(cuid())
  assetId     String
  asset       VehicleAgencyAsset @relation(fields: [assetId], references: [id])
  type        String
  dueDate     DateTime
  isDismissed Boolean            @default(false)
  createdAt   DateTime           @default(now())
}

model GstInvoice {
  id         String   @id @default(cuid())
  date       DateTime
  invoiceNo  String   @unique
  customerId String
  items      Json
  subtotal   Float
  gstAmount  Float
  total      Float
  status     String   @default("PENDING")
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DailyClosing {
  id                  String                 @id @default(cuid())
  date                DateTime
  totalDeliveries     Int                    @default(0)
  totalCashCollected  Float                  @default(0)
  totalOnlinePayment  Float                  @default(0)
  totalUdhari         Float                  @default(0)
  totalCollection     Float                  @default(0)  // cash + online
  pendingDeliveries   Int                    @default(0)
  returnedCylinders   Int                    @default(0)
  kmBasedExtra        Float                  @default(0)
  grandExpected       Float                  @default(0)
  cashOnHand          Float                  @default(0)  // actual physical cash counted by manager
  shortageAmount      Float                  @default(0)
  excessAmount        Float                  @default(0)
  cashVerified        Boolean                @default(false)
  cashVerifiedById    String?
  cashVerifiedAt      DateTime?
  notes               String?
  status              ApprovalStatus         @default(PENDING)
  managerApprovedAt   DateTime?
  adminApprovedAt     DateTime?
  agencyId            String
  agency              Agency                 @relation(fields: [agencyId], references: [id])
  employeeClosings    DailyClosingEmployee[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
}

model DailyClosingEmployee {
  id              String       @id @default(cuid())
  dailyClosingId  String
  dailyClosing    DailyClosing @relation(fields: [dailyClosingId], references: [id], onDelete: Cascade)
  deliveryBoyId   String
  deliveryBoy     User         @relation("EmployeeClosings", fields: [deliveryBoyId], references: [id])
  agencyId        String
  agency          Agency       @relation(fields: [agencyId], references: [id])

  // Cylinder category breakdown (auto-fetched + manager-editable)
  // Array: [{ productId, productName, soldQty, baseRate, kmRate, kmExtra, totalAmt }]
  cylinderBreakdown Json       @default("[]")

  // Summary fields
  totalDelivered  Int          @default(0)
  pendingQty      Int          @default(0)
  returnedQty     Int          @default(0)
  udhariAmount    Float        @default(0)
  cashCollected   Float        @default(0)
  onlineAmount    Float        @default(0)   // GPay/PhonePe/Paytm
  kmBasedExtra    Float        @default(0)   // additional due to distance pricing
  expectedTotal   Float        @default(0)   // system-calculated
  actualCashGiven Float        @default(0)   // physically given to manager
  shortageAmount  Float        @default(0)
  excessAmount    Float        @default(0)
  notes           String?

  // Audit
  fetchedFromDeliveries Boolean @default(true)
  isOfficeSale          Boolean  @default(false)
  editedByManagerId     String?
  editedAt              DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model DemoRequest {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String
  status    String   @default("NEW")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Internal delivery vehicle owned by the agency (not the company supplier vehicle)
model DeliveryVehicle {
  id               String          @id @default(cuid())
  vehicleNo        String
  vehicleName      String
  vehicleType      String          @default("Two-Wheeler") // Two-Wheeler, Three-Wheeler, Four-Wheeler
  status           VehicleStatus   @default(ACTIVE)
  assignedToId     String?         @unique
  assignedTo       User?           @relation("AssignedDeliveryBoy", fields: [assignedToId], references: [id])
  notes            String?
  agencyId         String
  agency           Agency          @relation(fields: [agencyId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tripLogs         VehicleTripLog[]
}

/// Daily trip log for internal delivery vehicle — recorded by godown keeper when vehicle goes out/returns
model VehicleTripLog {
  id                   String          @id @default(cuid())
  vehicleId            String
  vehicle              DeliveryVehicle @relation(fields: [vehicleId], references: [id])
  date                 DateTime
  cylindersLoaded      Int             @default(0)
  cylindersReturned    Int             @default(0)
  cylindersDelivered   Int             @default(0)
  items                Json?           // Array of objects: { productId: string, productName: string, loaded: number, unsoldReturned: number, emptyReturned: number }
  departureTime        DateTime?
  returnTime           DateTime?
  tripStatus           TripStatus      @default(LOADED)
  notes                String?
  recordedById         String
  recordedBy           User            @relation(fields: [recordedById], references: [id])
  agencyId             String
  agency               Agency          @relation(fields: [agencyId], references: [id])
  departureLat         Float?
  departureLng         Float?
  departureAccuracy    Float?
  returnLat            Float?
  returnLng            Float?
  returnAccuracy       Float?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

/// Stores the configured monthly salary for each employee (set by admin)
model EmployeeSalaryProfile {
  id              String   @id @default(cuid())
  employeeId      String   @unique
  employee        User     @relation(fields: [employeeId], references: [id])
  monthlySalary   Float    @default(0)   // Configured base salary
  effectiveFrom   DateTime               // When this salary takes effect
  notes           String?
  agencyId        String
  agency          Agency   @relation(fields: [agencyId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Tracks advance / udhari given to employees — recovered from future salaries
model SalaryAdvance {
  id              String        @id @default(cuid())
  employeeId      String
  employee        User          @relation(fields: [employeeId], references: [id])
  advanceDate     DateTime
  amount          Float                        // Total advance given
  recoveredAmount Float         @default(0)   // How much has been recovered so far
  balanceAmount   Float                        // Remaining to recover (amount - recoveredAmount)
  status          AdvanceStatus @default(PENDING)
  reason          String?                      // Why advance was given
  notes           String?
  agencyId        String
  agency          Agency        @relation(fields: [agencyId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

/// Bonus payments granted to employees
model SalaryBonus {
  id         String   @id @default(cuid())
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id])
  bonusDate  DateTime
  amount     Float
  month      Int                // Which month bonus is for
  year       Int
  reason     String?            // Festival bonus, performance, etc.
  remarks    String?
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Salary payment requests raised by manager or employee, require approvals
model SalaryPaymentRequest {
  id            String              @id @default(cuid())
  type          String              // SALARY | DRAWING | ADVANCE | ADVANCE_RECOVERY | BONUS
  employeeId    String
  employee      User                @relation("SalaryRequestEmployee", fields: [employeeId], references: [id])
  amount        Float
  month         Int?
  year          Int?
  requestData   Json                // Full payload; used by admin to create actual records on approval
  status        SalaryRequestStatus @default(PENDING)
  remarks       String?
  requestedById String
  requestedBy   User                @relation("SalaryRequestedBy", fields: [requestedById], references: [id])
  
  // Manager review
  managerReviewedById  String?
  managerReviewedBy    User?        @relation("SalaryManagerReviewer", fields: [managerReviewedById], references: [id])
  managerReviewNote    String?
  managerReviewedAt    DateTime?

  // Admin review
  reviewedById  String?
  reviewedBy    User?               @relation("SalaryReviewedBy", fields: [reviewedById], references: [id])
  reviewNote    String?
  
  agencyId      String
  agency        Agency              @relation(fields: [agencyId], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

/// Leave requests submitted by employees — approved or rejected by admin/manager
model LeaveRequest {
  id            String      @id @default(cuid())
  employeeId    String
  employee      User        @relation("EmployeeLeaves", fields: [employeeId], references: [id])
  leaveType     LeaveType
  startDate     DateTime
  endDate       DateTime
  totalDays     Float                       // 0.5 for half-day, 1+ for full days
  reason        String      @db.Text
  status        LeaveStatus @default(PENDING)
  reviewNote    String?                     // Reason for rejection or approval note
  reviewedById  String?
  reviewedBy    User?       @relation("ReviewedLeaves", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  agencyId      String
  agency        Agency      @relation(fields: [agencyId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ─── Security: Audit Log ──────────────────────────────────────────────────────

/// Immutable log of every significant action — required for enterprise compliance
model AuditLog {
  id         String   @id @default(cuid())
  agencyId   String?
  userId     String
  action     String   // e.g. "CREATE_SALARY_DRAWING", "DELETE_ADVANCE"
  entityType String   // e.g. "SalaryDrawing", "Customer"
  entityId   String?
  details    Json?    // { before: {...}, after: {...} }
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([agencyId, createdAt])
  @@index([userId])
}

// ─── Security: JWT Refresh Token Store ────────────────────────────────────────

/// Stores hashed refresh tokens — enables single-use rotation and revocation
model RefreshToken {
  id        String   @id @default(cuid())
  jti       String   @unique          // JWT ID — unique per token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String                    // bcrypt hash of the raw refresh token
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([jti])
}

/// Blacklist for access tokens — entries auto-expire after the token's natural TTL
model TokenBlacklist {
  id        String   @id @default(cuid())
  jti       String   @unique
  expiresAt DateTime  // auto-cleanup entries after this date
  createdAt DateTime @default(now())

  @@index([jti])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Phase 1 — New Models
// ═══════════════════════════════════════════════════════════════════════════════

/// In-app notification — created server-side, consumed by the NotificationBell UI component
model Notification {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id])
  userId    String                    // Recipient user
  user      User     @relation(fields: [userId], references: [id])
  type      String                    // LEAVE_REQUEST | SALARY_REQUEST | LOW_STOCK | VEHICLE_RENEWAL | DAILY_SUMMARY
  title     String
  body      String
  isRead    Boolean  @default(false)
  link      String?                   // Deep link to the relevant page e.g. /admin/leaves
  createdAt DateTime @default(now())

  @@index([agencyId, userId, isRead])
  @@index([createdAt])
}

/// Subscription / billing record per agency — tracks plan, billing cycle, and payment refs
model AgencySubscription {
  id           String   @id @default(cuid())
  agencyId     String   @unique
  agency       Agency   @relation(fields: [agencyId], references: [id])
  plan         String                    // basic | professional | enterprise
  billingCycle String                    // monthly | yearly
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(true)
  amount       Float
  paymentRef   String?                   // Razorpay / PhonePe transaction ID
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agencyId, isActive])
}

/// Log of every WhatsApp / SMS / Email message sent by the system
model MessageLog {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id])
  recipient String                    // Phone number or email address
  type      String                    // SALARY_SLIP | DELIVERY_REMINDER | LOW_STOCK | LEAVE_APPROVAL
  channel   String                    // WHATSAPP | SMS | EMAIL
  status    String                    // SENT | FAILED | DELIVERED | PENDING
  payload   Json?                     // Request payload sent to provider (for debugging)
  errorMsg  String?                   // Provider error message on failure
  sentAt    DateTime @default(now())

  @@index([agencyId, channel, status])
  @@index([sentAt])
}

/// Monthly delivery target / quota per delivery boy — tracks target vs achieved
model DeliveryTarget {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  employeeId  String
  employee    User     @relation(fields: [employeeId], references: [id])
  month       Int                       // 1–12
  year        Int
  targetQty   Int                       // Target cylinders to deliver
  achievedQty Int      @default(0)      // Actual deliveries made
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([agencyId, employeeId, month, year])  // One target per employee per month
  @@index([agencyId, year, month])
}

/// Customer complaint tracker — raised by customers or staff, resolved by admin/manager
model CustomerComplaint {
  id           String    @id @default(cuid())
  agencyId     String
  agency       Agency    @relation(fields: [agencyId], references: [id])
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  category     String                   // DELIVERY_DELAY | WRONG_CYLINDER | BILLING | CYLINDER_DAMAGE | OTHER
  description  String    @db.Text
  status       String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("ComplaintResolver", fields: [resolvedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([agencyId, status])
  @@index([customerId])
}

/// Delivery route plan — defines a named sequence of customer stops assigned to a delivery boy
model DeliveryRoute {
  id           String   @id @default(cuid())
  agencyId     String
  agency       Agency   @relation(fields: [agencyId], references: [id])
  name         String
  assignedToId String?
  assignedTo   User?    @relation(fields: [assignedToId], references: [id])
  stops        Json                     // Array of { customerId, customerName, address, order }
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agencyId, isActive])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Phase 2 — New Models
// ═══════════════════════════════════════════════════════════════════════════════

/// Predefined expense category with monthly budget — for structured expense tracking
model ExpenseCategory {
  id            String   @id @default(cuid())
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id])
  name          String                    // e.g. Fuel, Vehicle Maintenance, Office Supplies
  monthlyBudget Float    @default(0)      // Budget allocated per month
  color         String?                   // Hex color for chart display e.g. #3B82F6
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expenses          Expense[]                 // Linked actual expenses
  employeeExpenses  EmployeeExpense[]

  @@unique([agencyId, name])
  @@index([agencyId, isActive])
}

/// Daily employee attendance — punch in/out record per employee per day
model Attendance {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  employeeId  String
  employee    User     @relation(fields: [employeeId], references: [id])
  date        DateTime                    // Normalized to midnight of the day
  punchIn     DateTime?                   // When employee punched in
  punchOut    DateTime?                   // When employee punched out
  status      String   @default("PRESENT") // PRESENT | ABSENT | HALF_DAY | ON_LEAVE | HOLIDAY
  punchInLat  Float?                      // GPS latitude at punch-in
  punchInLng  Float?                      // GPS longitude at punch-in
  punchOutLat Float?                      // GPS latitude at punch-out
  punchOutLng Float?                      // GPS longitude at punch-out
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([agencyId, employeeId, date])  // One record per employee per day
  @@index([agencyId, date])
  @@index([employeeId])
}

/// Formal payment receipt for customer cash/UPI/bank collections
model PaymentReceipt {
  id            String   @id @default(cuid())
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  amount        Float
  paymentMode   String                    // CASH | UPI | BANK_TRANSFER | CHEQUE
  utrNo         String?                   // UTR / reference number for UPI / bank
  receiptNo     String   @unique          // Auto-generated receipt number e.g. RCP-2026-0001
  collectedById String
  collectedBy   User     @relation(fields: [collectedById], references: [id])
  date          DateTime
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([agencyId, date])
  @@index([customerId])
}

/// Document storage — KYC, vehicle RC, insurance, FC per employee or vehicle
model Document {
  id           String    @id @default(cuid())
  agencyId     String
  agency        Agency   @relation(fields: [agencyId], references: [id])
  entityType   String                    // USER | VEHICLE | AGENCY
  entityId     String                    // ID of the related user/vehicle/agency
  docType      String                    // AADHAAR | PAN | RC | INSURANCE | FC | LICENSE | OTHER
  fileName     String
  fileBase64   String?   @db.Text        // Base64-encoded file (LOCAL storage only)
  mimeType     String    @default("application/pdf")
  expiryDate   DateTime?                 // For insurance, FC, license — triggers renewal alerts
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // ── Google Drive Storage ────────────────────────────────────────────────
  storageType  String    @default("LOCAL")   // LOCAL | GOOGLE_DRIVE
  driveFileId  String?                       // Google Drive file ID (used for delete)
  driveViewUrl String?                       // Shareable Drive view link

  @@index([agencyId, entityType, entityId])
  @@index([expiryDate])
}

// ─── Phase 3: Enterprise Infrastructure ─────────────────────────────────────

/// Branch — a physical distribution point under an Agency (3.2 Multi-Branch)
model Branch {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id])
  name      String
  address   String
  city      String   @default("")
  phone     String?
  managerId String?                    // Optional branch manager (User)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
}

/// API Key — for 3rd-party integrations (3.3 API Gateway)
model ApiKey {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  name        String                    // Human-readable label
  keyHash     String   @unique          // bcrypt hash of the raw API key
  prefix      String                    // First 8 chars shown to user (e.g. "gak_a1b2")
  scopes      String[]                  // e.g. ["customers:read", "deliveries:write"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([agencyId])
}

/// Webhook — fire HTTP callbacks on key events (3.3 API Gateway)
model Webhook {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id])
  url       String
  events    String[]                   // e.g. ["delivery.completed", "payment.received"]
  secret    String                     // HMAC signing secret
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
}

/// Background job run log — tracks Inngest job execution (3.4)
model JobLog {
  id         String   @id @default(cuid())
  agencyId   String?
  jobName    String                    // e.g. "daily-stock-snapshot"
  status     String                    // QUEUED | RUNNING | SUCCESS | FAILED
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  error      String?
  meta       Json?

  @@index([agencyId, jobName])
  @@index([startedAt])
}

// ─── Phase 4: UX & Feature Polish ───────────────────────────────────────────

model RolePermission {
  id         String   @id @default(cuid())
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  role       String
  resource   String   // e.g. "customers", "salaries", "godown", "billing"
  action     String   // e.g. "read", "create", "update", "delete"
  isAllowed  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([agencyId, role, resource, action])
  @@index([agencyId])
}

model LeaveBalance {
  id         String   @id @default(cuid())
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year       Int
  casual     Float    @default(12)
  sick       Float    @default(10)
  earned     Float    @default(10)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([agencyId, employeeId, year])
  @@index([agencyId])
}

// ─── SaaS Billing: Cashfree Payment Transactions ─────────────────────────────

/// Tracks every Cashfree payment order created for subscription upgrades
model CashfreeTransaction {
  id               String   @id @default(cuid())
  agencyId         String
  agency           Agency   @relation(fields: [agencyId], references: [id])
  orderId          String   @unique    // Cashfree order ID (gak_<agencyId>_<ts>)
  paymentSessionId String              // Used by Cashfree JS SDK to open checkout
  amount           Float               // INR amount charged
  currency         String   @default("INR")
  plan             String              // basic | professional | enterprise
  billingCycle     String              // monthly | yearly
  status           String   @default("ACTIVE") // ACTIVE | PAID | FAILED | EXPIRED
  cfPaymentId      String?             // Cashfree's internal payment ID (filled on webhook)
  cfPaymentStatus  String?             // CAPTURED | FAILED | etc (from Cashfree webhook)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([agencyId, status])
  @@index([orderId])
}

/// Direct bank transfer payments to the oil company for cylinder stock
/// This is the PRIMARY cost of goods — the single largest cash outflow
model CompanyPayment {
  id            String   @id @default(cuid())
  date          DateTime                         // Actual bank transfer date
  amount        Float                            // ₹ transferred
  paymentMode   String   @default("NEFT")
  // NEFT | RTGS | IMPS | CHEQUE | UPI | DD | BANK_TRANSFER
  referenceNo   String?                          // UTR no. / cheque no.
  invoiceNo     String?                          // Oil company bill / invoice no.
  productId     String?                          // Which cylinder type paid for
  product       Product? @relation(fields: [productId], references: [id])
  qtyCylinders  Int?                             // Approx cylinders covered
  oilCompany    String?                          // HP | INDANE | BHARATGAS | OTHER
  description   String?
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id])
  addedById     String
  addedBy       User     @relation(fields: [addedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([agencyId, date])
}

model CustomRole {
  id        String   @id @default(cuid())
  name      String   // e.g. "Accountant", "Supervisor"
  baseRole  Role     // MANAGER, STAFF, etc.
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, name])
  @@index([agencyId])
}

model WorkShift {
  id           String   @id @default(cuid())
  agencyId     String
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name         String   // "Morning Shift", "Full Day"
  startTime    String   // "09:00" (HH:mm)
  endTime      String   // "18:00"
  gracePeriod  Int      @default(15) // minutes allowed before flagging late
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([agencyId, name])
  @@index([agencyId])
}

model AttendanceRegularization {
  id                String    @id @default(cuid())
  agencyId          String
  agency            Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          User      @relation("RegularizationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  date              DateTime
  reason            String    @db.Text
  requestedPunchIn  DateTime?
  requestedPunchOut DateTime?
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote        String?
  reviewedById      String?
  reviewedBy        User?     @relation("RegularizationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([agencyId, status])
  @@index([employeeId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Personal Finance & Accounts Models
// ═══════════════════════════════════════════════════════════════════════════════

enum PersonalAccountType {
  SAVINGS          // Savings bank account
  CURRENT          // Current/business account
  CASH             // Physical cash in hand
  WALLET           // PhonePe / GPay / Paytm wallet
  FD               // Fixed Deposit (non-liquid, for visibility only)
  LOAN             // Outstanding personal loan
}

enum PersonalTxnType {
  INCOME           // Money received (salary, rent, other income)
  EXPENSE          // Money spent (personal purchase, utility)
  PAID_TO          // Paid to a person / vendor (debit)
  RECEIVED_FROM    // Received from a person (credit)
  UDHAARI_GIVEN    // Lent money to someone (personal udhaari out)
  UDHAARI_RECEIVED // Someone paid back (udhaari recovery)
  TRANSFER_OUT     // Transferred to another account / agency
  TRANSFER_IN      // Received transfer from another account / agency
  AGENCY_DEPOSIT   // Owner deposited personal money into agency
  AGENCY_WITHDRAWAL// Owner withdrew from agency funds
}

enum UdhaariStatus {
  OUTSTANDING      // Not yet recovered
  PARTIAL          // Partially recovered
  SETTLED          // Fully settled
  WRITTEN_OFF      // Bad debt — written off
}

enum ChequeStatus {
  PENDING     // Not yet presented to bank
  PRESENTED   // Submitted to bank for clearing
  CLEARED     // Honoured — money debited
  BOUNCED     // Returned / dishonoured
  CANCELLED   // Voided before presentation
}

enum FdLoanType {
  FIXED_DEPOSIT
  RECURRING_DEPOSIT
  PERSONAL_LOAN
  BUSINESS_LOAN
  VEHICLE_LOAN
  HOME_LOAN
  CC_LIMIT        // Credit card limit tracker
}

/// Owner's personal bank / cash account — e.g., SBI savings, HDFC current, Cash-in-Hand
model PersonalAccount {
  id            String              @id @default(cuid())
  agencyId      String
  agency        Agency              @relation(fields: [agencyId], references: [id])
  ownerId       String                             // Always ADMIN user
  owner         User                @relation(fields: [ownerId], references: [id])
  name          String                             // e.g. "SBI Savings - 4521", "Cash in Hand"
  accountType   PersonalAccountType
  bankName      String?                            // e.g. SBI, HDFC, ICICI
  accountNo     String?                            // Last 4 digits only for display
  ifscCode      String?
  openingBalance Float             @default(0)     // Balance at time of account creation
  currentBalance Float             @default(0)     // Computed / manually tracked
  isAgencyAccount Boolean          @default(false) // True = this is the official agency bank account
  color         String?                            // UI color code for card
  isActive      Boolean            @default(true)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  transactions  PersonalTransaction[]
  udhaariGiven  PersonalUdhaari[]  @relation("UdhaariFromAccount")
  udhaariReceived PersonalUdhaari[] @relation("UdhaariToAccount")

  @@index([agencyId, ownerId])
}

/// Single financial transaction in any personal account
model PersonalTransaction {
  id            String            @id @default(cuid())
  agencyId      String
  agency        Agency            @relation(fields: [agencyId], references: [id])
  accountId     String
  account       PersonalAccount   @relation(fields: [accountId], references: [id])
  date          DateTime
  type          PersonalTxnType
  amount        Float                              // Always positive; type determines direction
  description   String
  partyName     String?                            // Who you paid / received from
  partyPhone    String?                            // Optional contact
  paymentMode   String?                            // CASH | UPI | NEFT | CHEQUE | IMPS
  referenceNo   String?                            // UTR / cheque no.
  
  // For agency-linked transactions
  linkedModule  String?                            // "SALARY" | "EXPENSE" | "COMPANY_PAYMENT" | "TRANSFER"
  linkedRecordId String?                           // ID of the linked record in operational module
  toAccountId   String?                            // For TRANSFER_OUT: destination account ID
  
  // For udhaari-linked transactions
  udhaariId     String?                            // Links to PersonalUdhaari record
  
  tags          String[]           @default([])    // Custom tags e.g. "festival", "petrol"
  receiptBase64 String?            @db.Text        // Optional photo of receipt
  notes         String?
  
  addedById     String
  addedBy       User              @relation(fields: [addedById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([agencyId, accountId, date])
  @@index([date])
}

/// Personal Udhaari Ledger — money lent to or borrowed from individuals
model PersonalUdhaari {
  id              String         @id @default(cuid())
  agencyId        String
  agency          Agency         @relation(fields: [agencyId], references: [id])
  partyName       String                          // Person's name
  partyPhone      String?
  partyRelation   String?                         // "Friend", "Relative", "Supplier", "Customer"
  direction       String                          // "GIVEN" (I lent) | "TAKEN" (I borrowed)
  totalAmount     Float                           // Original amount
  recoveredAmount Float          @default(0)     // How much has been returned
  balanceAmount   Float                           // Remaining
  status          UdhaariStatus  @default(OUTSTANDING)
  startDate       DateTime
  dueDate         DateTime?                       // Expected settlement date
  fromAccountId   String?                         // Account money was taken from (GIVEN)
  fromAccount     PersonalAccount? @relation("UdhaariFromAccount", fields: [fromAccountId], references: [id])
  toAccountId     String?                         // Account money was deposited to (TAKEN)
  toAccount       PersonalAccount? @relation("UdhaariToAccount", fields: [toAccountId], references: [id])
  reason          String?
  notes           String?
  addedById       String
  addedBy         User           @relation(fields: [addedById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  recoveries      UdhaariRecovery[]
  reminders       UdhaariReminder[]

  @@index([agencyId, status])
}

/// Partial recovery record for personal udhaari
model UdhaariRecovery {
  id          String          @id @default(cuid())
  udhaariId   String
  udhaari     PersonalUdhaari @relation(fields: [udhaariId], references: [id])
  date        DateTime
  amount      Float
  paymentMode String?         // CASH | UPI | BANK_TRANSFER
  notes       String?
  addedById   String
  addedBy     User            @relation(fields: [addedById], references: [id])
  createdAt   DateTime        @default(now())
}

model UdhaariReminder {
  id          String          @id @default(cuid())
  udhaariId   String
  udhaari     PersonalUdhaari @relation(fields: [udhaariId], references: [id])
  scheduledAt DateTime
  channel     String          @default("WHATSAPP")  // WHATSAPP | SMS
  message     String          @db.Text
  status      String          @default("PENDING")   // PENDING | SENT | FAILED
  sentAt      DateTime?
  errorMsg    String?
  createdAt   DateTime        @default(now())
}

model ChequeRegister {
  id                     String       @id @default(cuid())
  agencyId               String
  agency                 Agency       @relation(fields: [agencyId], references: [id])
  chequeNo               String
  bankName               String                          // Bank cheque drawn on
  accountId              String?                         // Linked PersonalAccount
  chequeDate             DateTime                        // PDC date written on cheque
  amount                 Float
  payeeName              String                          // HP / Indane / vendor / person
  purpose                String?
  status                 ChequeStatus @default(PENDING)
  presentedDate          DateTime?
  clearedDate            DateTime?
  bounceReason           String?
  linkedCompanyPaymentId String?
  notes                  String?
  addedById              String
  addedBy                User         @relation(fields: [addedById], references: [id])
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([agencyId, status])
  @@index([chequeDate])
}

model OilCompanyLedger {
  id                     String   @id @default(cuid())
  agencyId               String
  agency                 Agency   @relation(fields: [agencyId], references: [id])
  oilCompany             String   // HP | INDANE | BHARATGAS
  date                   DateTime
  type                   String   // INVOICE | PAYMENT | ADJUSTMENT
  invoiceNo              String?
  amount                 Float    // Positive = payable, Negative = payment made
  description            String?
  linkedCompanyPaymentId String?  // FK to CompanyPayment
  addedById              String
  addedBy                User     @relation(fields: [addedById], references: [id])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([agencyId, oilCompany])
}

model DailyCashReconciliation {
  id                 String   @id @default(cuid())
  agencyId           String
  agency             Agency   @relation(fields: [agencyId], references: [id])
  date               DateTime
  openingCash        Float    @default(0)  // Cash at start of day
  cashFromDeliveries Float    @default(0)  // Auto-pulled from DailyClosing
  cashFromOffice     Float    @default(0)  // Office transaction cash
  cashExpenses       Float    @default(0)  // Cash expenses paid today
  cashSalaries       Float    @default(0)  // Salaries paid in cash today
  cashDeposited      Float    @default(0)  // Deposited to bank today
  expectedClosing    Float    @default(0)  // Computed: opening + in - out
  actualClosing      Float    @default(0)  // Owner manually enters physical count
  variance           Float    @default(0)  // Difference (shortage/excess)
  varianceReason     String?
  status             String   @default("OPEN")  // OPEN | RECONCILED | DISCREPANCY
  reconciledById     String?
  reconciledBy       User?    @relation(fields: [reconciledById], references: [id])
  reconciledAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([agencyId, date])
  @@index([agencyId, date])
}

model FdLoanRecord {
  id              String      @id @default(cuid())
  agencyId        String
  agency          Agency      @relation(fields: [agencyId], references: [id])
  type            FdLoanType
  bankName        String
  accountRef      String?     // FD receipt no. / loan account no.
  principalAmount Float
  interestRate    Float       // % per annum
  startDate       DateTime
  maturityDate    DateTime?   // FD/RD maturity
  emiAmount       Float?      // Monthly EMI for loans
  emiDay          Int?        // Day of month EMI due (1–31)
  currentValue    Float?      // FD maturity value or loan outstanding
  isActive        Boolean     @default(true)
  notes           String?
  addedById       String
  addedBy         User        @relation(fields: [addedById], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  emiPayments     EmiPayment[]
  @@index([agencyId, type])
}

model EmiPayment {
  id          String       @id @default(cuid())
  recordId    String
  record      FdLoanRecord @relation(fields: [recordId], references: [id])
  dueDate     DateTime
  paidDate    DateTime?
  amount      Float
  isPaid      Boolean      @default(false)
  penaltyAmt  Float        @default(0)
  linkedTxnId String?      // FK to PersonalTransaction
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([recordId, isPaid])
}

model VendorLedger {
  id             String            @id @default(cuid())
  agencyId       String
  agency         Agency            @relation(fields: [agencyId], references: [id])
  vendorName     String
  vendorPhone    String?
  vendorType     String            // OIL_COMPANY | REGULATOR | PIPE | MAINTENANCE | OTHER
  gstNo          String?
  openingBalance Float             @default(0)   // Positive = we owe them
  currentBalance Float             @default(0)
  creditLimit    Float?
  notes          String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  entries        VendorLedgerEntry[]
  @@index([agencyId, vendorType])
}

model VendorLedgerEntry {
  id          String       @id @default(cuid())
  vendorId    String
  vendor      VendorLedger @relation(fields: [vendorId], references: [id])
  date        DateTime
  type        String       // PURCHASE | PAYMENT | RETURN | ADJUSTMENT
  amount      Float
  invoiceNo   String?
  description String?
  paymentMode String?
  linkedTxnId String?      // FK to PersonalTransaction
  addedById   String
  addedBy     User         @relation(fields: [addedById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([vendorId, date])
}

model EmployeeExpense {
  id                  String                @id @default(cuid())
  agencyId            String
  agency              Agency                @relation(fields: [agencyId], references: [id])
  submittedById       String
  submittedBy         User                  @relation("ExpenseSubmittedBy", fields: [submittedById], references: [id])
  expenseDate         DateTime
  categoryId          String?
  expenseCategory     ExpenseCategory?      @relation(fields: [categoryId], references: [id])
  categoryLabel       String
  amount              Float
  receiptUrl          String?
  receiptPublicId     String?
  note                String?
  status              EmployeeExpenseStatus @default(PENDING)
  managerId           String?
  manager             User?                 @relation("ExpenseManager", fields: [managerId], references: [id])
  managerNote         String?
  managerReviewedAt   DateTime?
  adminId             String?
  admin               User?                 @relation("ExpenseAdmin", fields: [adminId], references: [id])
  adminNote           String?
  adminReviewedAt     DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([agencyId, status])
  @@index([submittedById])
}

